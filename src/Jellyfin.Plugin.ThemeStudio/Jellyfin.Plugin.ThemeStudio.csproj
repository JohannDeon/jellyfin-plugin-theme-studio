<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One build per Jellyfin generation: net9.0 = Jellyfin 10.11, net10.0 = Jellyfin 12 -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.ThemeStudio</RootNamespace>
    <!-- Plugin version. The 4th number tells the builds apart (11 = Jellyfin 10.11, 12 = Jellyfin 12) -->
    <PluginVersion>1.3.0</PluginVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Jellyfin version each build compiles against; also used as targetAbi in manifest.json -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <JellyfinVersion>10.11.0</JellyfinVersion>
    <AbiTag>11</AbiTag>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <JellyfinVersion>12.0.0</JellyfinVersion>
    <AbiTag>12</AbiTag>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyVersion>$(PluginVersion).$(AbiTag)</AssemblyVersion>
    <FileVersion>$(PluginVersion).$(AbiTag)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\client.js" />
    <EmbeddedResource Include="Web\engine.css" />
    <EmbeddedResource Include="Web\themes.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.ThemeStudio.Tests" />
  </ItemGroup>

</Project>
